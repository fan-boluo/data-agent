# DataAgent docker-compose 根目录环境变量示例
# 复制为 .env 后填入真实值（.env 不要提交到 Git）

# 对外端口
FRONTEND_PORT=80
APP_PORT=8456

# MySQL（与 backend/.env 中的 MYSQL_DB / MYSQL_USER / MYSQL_PASSWORD 保持一致）
MYSQL_ROOT_PASSWORD=change_me_please
MYSQL_DB=dataagent
MYSQL_USER=user
MYSQL_PASSWORD=change_me_please
MYSQL_HOST_PORT=3307

# PostgreSQL（与 backend/.env 中的值保持一致）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=5433

# Redis
REDIS_PASSWORD=change_me_please
REDIS_HOST_PORT=6380

# Qdrant
QDRANT_HOST_PORT=6333

# 监控栈（--profile monitoring）
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_please
ALERTMANAGER_PORT=9093
ALERT_SINK_PORT=9000
# Prometheus 抓取目标：默认容器内 backend；后端跑宿主机时改为 host.docker.internal:8456
BACKEND_TARGET=backend:8456
