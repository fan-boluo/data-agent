{
  "uid": "dataagent-overview",
  "title": "DataAgent · Agent 运行总览",
  "tags": [
    "DataAgent",
    "agent"
  ],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LLM 熔断 OPEN 数",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (circuit) (codegenx_llm_circuit_state == 2)) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "LLM 熔断状态（0=CLOSED 1=HALF_OPEN 2=OPEN；变绿即恢复）",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (circuit) (codegenx_llm_circuit_state)",
          "legendFormat": "{{circuit}}"
        }
      ],
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "HALF_OPEN",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "OPEN",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "工具熔断 OPEN 数",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (tool_name) (codegenx_tool_circuit_state == 2)) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "模型健康矩阵（LLM + Embedding）",
      "description": "当前状态全貌：熔断 / 重试中 / 上次重试次数 / 降级至 / 最近失败（含 trace_id 与分类）。P95 与首 Token 已在下方时序图展示，此处不重复；请求量趋势由前端出图。",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(max by (circuit) (codegenx_llm_circuit_state), \"model\", \"$1\", \"circuit\", \".+:(.+)\") or label_replace(max by (circuit) (codegenx_embedding_circuit_state), \"model\", \"$1\", \"circuit\", \".+:(.+)\")",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (model) (codegenx_llm_retrying) or max by (model) (label_replace(codegenx_llm_circuit_state, \"model\", \"$1\", \"circuit\", \".+:(.+)\")) * 0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (model) (codegenx_llm_last_retries) or max by (model) (label_replace(codegenx_llm_circuit_state, \"model\", \"$1\", \"circuit\", \".+:(.+)\")) * 0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (model, target) (codegenx_llm_last_fallback_seconds) or (label_replace(0 * (label_replace(max by (circuit) (codegenx_llm_circuit_state or codegenx_embedding_circuit_state), \"model\", \"$1\", \"circuit\", \".+:(.+)\")), \"target\", \"-\", \"model\", \".*\") unless on (model) max by (model) (codegenx_llm_last_fallback_seconds))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "((max by (model) (codegenx_llm_last_failure_seconds) or max by (model) (codegenx_embedding_last_failure_seconds)) * 1000) or (0 * (label_replace(max by (circuit) (codegenx_llm_circuit_state or codegenx_embedding_circuit_state), \"model\", \"$1\", \"circuit\", \".+:(.+)\")))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "max by (model, error_class, trace_id) (codegenx_llm_last_failure_info) or max by (model, error_class, trace_id) (codegenx_embedding_last_failure_info) or (label_replace(label_replace(0 * (label_replace(max by (circuit) (codegenx_llm_circuit_state or codegenx_embedding_circuit_state), \"model\", \"$1\", \"circuit\", \".+:(.+)\")), \"error_class\", \"-\", \"model\", \".*\"), \"trace_id\", \"-\", \"model\", \".*\") unless on (model) (max by (model) (codegenx_llm_last_failure_info) or max by (model) (codegenx_embedding_last_failure_info)))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "model",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "service": true,
              "circuit": true
            },
            "renameByName": {
              "model": "模型",
              "target": "降级至",
              "error_class": "失败分类"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "熔断状态"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "color": "green",
                        "index": 0,
                        "text": "CLOSED"
                      },
                      "1": {
                        "color": "yellow",
                        "index": 1,
                        "text": "HALF_OPEN"
                      },
                      "2": {
                        "color": "red",
                        "index": 2,
                        "text": "OPEN"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "wrapText": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "重试中"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "上次重试"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "最近失败"
              },
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "-",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #F"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "模型请求速率（成功；掉量=流量已切到 fallback）",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(codegenx_llm_calls_total{outcome=\"ok\"}[1h]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "模型错误率（5m 窗口）",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(codegenx_llm_calls_total{outcome=~\"error_.*\"}[5m])) / clamp_min(sum by (model) (rate(codegenx_llm_calls_total[5m])), 1e-9)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM / Embedding 延迟（P50/P95，按模型）",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(codegenx_llm_latency_seconds_bucket[1h])))",
          "legendFormat": "{{model}} · P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(codegenx_llm_latency_seconds_bucket[1h])))",
          "legendFormat": "{{model}} · P95"
        },
        {
          "refId": "E95",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(codegenx_embedding_latency_seconds_bucket[1h])))",
          "legendFormat": "emb {{model}} P95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*P50"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "LLM 与 Embedding 的调用延迟分位；P95 爬升=慢劣化"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "首 Token 延迟 P50 / P95（按模型）",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(codegenx_llm_first_token_seconds_bucket[1h])))",
          "legendFormat": "{{model}} · P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(codegenx_llm_first_token_seconds_bucket[1h])))",
          "legendFormat": "{{model}} · P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*P50"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "生成速率（tokens/s，按模型）",
      "description": "completion tokens / LLM 调用耗时，真实反映模型产出速度；下降说明模型变慢或被限流。",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(codegenx_llm_completion_tokens_total[1h])) / clamp_min(sum by (model) (rate(codegenx_llm_latency_seconds_sum[1h])), 1e-9)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Embedding 最近失败时间",
      "gridPos": {
        "x": 8,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (model, error_class) (codegenx_embedding_last_failure_seconds) * 1000",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "最近失败"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "最近一次 embedding 批次失败的时刻与错误分类（超时/限流/鉴权/连接）。为空表示从未失败。",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "error_class": "失败分类",
              "Value #A": "最近失败"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "工具延迟 P95（TOP6）",
      "description": "窗口 6h。窗口内无调用的工具不会有线（断点是流量稀疏，不是指标缺失）；注意 dispatch_agent 含子 agent 全流程耗时，天然比普通工具大。",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(6, histogram_quantile(0.95, sum by (le, tool_name) (rate(codegenx_tool_latency_seconds_bucket{tool_name!=\"dispatch_agent\"}[6h]))))",
          "legendFormat": "{{tool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "state-timeline",
